# ---- CampusLedger server configuration ----
# Copy this file to `server/.env` and fill in real values.

# Port the Express API listens on (Vite dev server proxies /api here)
PORT=4000

# Public URL of the frontend, used inside student emails (login link)
APP_URL=http://localhost:5173

# Secret used to sign JWT session cookies - use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Admin account (there is NO admin signup - this account comes from env vars)
ADMIN_EMAIL=admin@campusledger.edu
ADMIN_PASSWORD=Admin@Campus123

# SQLite database file (created automatically). Ignored by git.
DATABASE_PATH=./data/campusledger.sqlite

# ---- Gmail SMTP (Nodemailer) ----
# Gmail requires 2-Step Verification and a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=CampusLedger <your-account@gmail.com>

# Optional: force transport mode.
#   smtp = send real email through the SMTP settings above
#   dev  = never send; print emails to the server console (default when SMTP_USER/SMTP_PASS are empty)
# MAIL_TRANSPORT=dev

# Optional: override where assignment uploads are stored (default: server/uploads/assignments)
# UPLOADS_DIR=./uploads/assignments
